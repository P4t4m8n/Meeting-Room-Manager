CREATE OR ALTER PROCEDURE MeetingSchema.usp_Bookings_Select_Many
    @StartDate DATETIME2 = NULL,
    @EndDate DATETIME2 = NULL,
    @RoomId UNIQUEIDENTIFIER = NULL,
    @Status NVARCHAR(20) = NULL,
    @UserId UNIQUEIDENTIFIER = NULL
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        b.Id,
        b.RoomId,
        b.UserId,
        b.StartTime,
        b.EndTime,
        b.BufferMinutes,
        b.Status,
        b.CalendarEventId,
        b.CreatedAt,
        b.UpdatedAt,
        JSON_QUERY(
            (SELECT r.Id, r.Name, r.Floor, r.Capacity, r.HasProjector, r.HasTeamMeeting, r.HasConferenceCall, r.ImageUrl
        FROM MeetingSchema.Rooms r
        WHERE r.Id = b.RoomId
        FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)
        ) AS Room,
        JSON_QUERY(
            (SELECT u.Id, u.Email, u.Name, u.Role
        FROM MeetingSchema.Users u
        WHERE u.Id = b.UserId
        FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)
        ) AS [User],
        JSON_QUERY(
            (SELECT ba.Id, ba.Email, ba.Name
        FROM MeetingSchema.BookingAttendees ba
        WHERE ba.BookingId = b.Id
        FOR JSON PATH)
        ) AS Attendees
    FROM MeetingSchema.Bookings b
    WHERE 
        (@StartDate IS NULL OR b.StartTime >= @StartDate)
        AND (@EndDate IS NULL OR b.EndTime <= @EndDate)
        AND (@RoomId IS NULL OR b.RoomId = @RoomId)
        AND (@Status IS NULL OR b.Status = @Status)
        AND (@UserId IS NULL OR b.UserId = @UserId)
    ORDER BY b.StartTime DESC
    FOR JSON PATH;
    END
GO



